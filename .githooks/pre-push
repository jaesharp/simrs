#!/bin/sh
# Run fmt, tests, and clippy before pushing.
# Install: git config core.hooksPath .githooks

echo "pre-push: checking formatting..."
if ! cargo fmt --all -- --check; then
    echo "pre-push: formatting issues found. Run 'cargo fmt --all'."
    exit 1
fi

echo "pre-push: running tests..."
if ! cargo test --workspace; then
    echo "pre-push: tests failed. Push aborted."
    exit 1
fi

echo "pre-push: running clippy..."
if ! cargo clippy --workspace --all-targets -- -D warnings; then
    echo "pre-push: clippy warnings found. Push aborted."
    exit 1
fi
